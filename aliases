# Cmder Aliases
# Migrated from CmderConfig.xml > EnvironmentSet
#
# These are Cmder/cmd.exe aliases (user-aliases.cmd format).
# For other shells, see the sections below.
#
# Cmder location: %CMDER_ROOT%\config\user-aliases.cmd
# ============================================================================

; ----- Personal -----
..=cd ..
proj=cd C:\Users\robert\Projects
ps=powershell.exe -noexit -file $*
sln=powershell -command "Get-ChildItem *.sln -r | % { start $_ }"
codef=code -n .

; ----- Chocolatey -----
clocal=clist --local-only
cversion=clist --all-versions $*
cupa=cup all
cinstv=cinst $1 -m --version=$2


